<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>500 - Lỗi server | MEU CMS</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body
    class="min-h-screen bg-gradient-to-br from-red-500 via-orange-500 to-yellow-500 flex items-center justify-center p-4">
    <div class="text-center">
        <h1 class="text-9xl font-bold text-white/20">500</h1>
        <h2 class="text-3xl font-bold text-white mb-4 -mt-8">Lỗi máy chủ</h2>
        <p class="text-white/80 mb-8 max-w-md mx-auto">
            Đã xảy ra lỗi trên máy chủ. Vui lòng thử lại sau.
        </p>
        <% if (typeof error !=='undefined' && error && process.env.NODE_ENV !=='production' ) { %>
            <div class="bg-white/10 rounded-xl p-4 mb-8 text-left max-w-2xl mx-auto">
                <p class="text-white/70 text-sm font-mono">
                    <%= error %>
                </p>
            </div>
            <% } %>
                <div class="flex gap-4 justify-center">
                    <a href="/"
                        class="bg-white text-red-600 px-6 py-3 rounded-xl font-medium hover:bg-white/90 transition">
                        Về trang chủ
                    </a>
                    <button onclick="location.reload()"
                        class="bg-white/20 text-white border-2 border-white/50 px-6 py-3 rounded-xl font-medium hover:bg-white/30 transition">
                        Thử lại
                    </button>
                </div>
    </div>
</body>

</html>