<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý sản phẩm | MEU CMS</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500">
    <%- include('../partials/navbar') %>

        <div class="container mx-auto px-4 py-8">
            <!-- Header -->
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
                <div>
                    <h1 class="text-3xl font-bold text-white">Quản lý sản phẩm</h1>
                    <p class="text-white/70 mt-1">Danh sách tất cả sản phẩm trong hệ thống</p>
                </div>
                <% if (typeof user !=='undefined' && user && (user.role==='admin' || user.role==='editor' )) { %>
                    <a href="/products/create"
                        class="bg-white text-indigo-600 px-6 py-3 rounded-xl font-medium hover:bg-white/90 transition flex items-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                        Thêm sản phẩm
                    </a>
                    <% } %>
            </div>

            <!-- Alerts -->
            <% if (typeof error !=='undefined' && error) { %>
                <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded-r-lg">
                    <p>
                        <%= error %>
                    </p>
                </div>
                <% } %>

                    <% if (typeof success !=='undefined' && success) { %>
                        <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 mb-6 rounded-r-lg">
                            <p>
                                <%= success %>
                            </p>
                        </div>
                        <% } %>

                            <!-- Products Grid -->
                            <% if (typeof products !=='undefined' && products && products.length> 0) { %>
                                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                                    <% products.forEach(function(product) { %>
                                        <div
                                            class="bg-white/95 backdrop-blur-md rounded-2xl shadow-lg overflow-hidden group hover:shadow-2xl transition duration-300">
                                            <!-- Image Placeholder -->
                                            <div
                                                class="h-48 bg-gradient-to-br from-indigo-100 to-purple-100 flex items-center justify-center">
                                                <svg class="w-16 h-16 text-indigo-300" fill="none" stroke="currentColor"
                                                    viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                                </svg>
                                            </div>

                                            <!-- Content -->
                                            <div class="p-6">
                                                <h3
                                                    class="text-lg font-bold text-gray-800 mb-2 group-hover:text-indigo-600 transition">
                                                    <%= product.name %>
                                                </h3>
                                                <p class="text-gray-500 text-sm mb-4 line-clamp-2">
                                                    <%= product.description || 'Không có mô tả' %>
                                                </p>

                                                <div class="flex justify-between items-center">
                                                    <span class="text-sm text-gray-500">ID: #<%= product.id ||
                                                            product._id %></span>
                                                    <div class="flex gap-2">
                                                        <a href="/products/<%= product.id || product._id %>"
                                                            class="text-indigo-600 hover:text-indigo-800 p-2">
                                                            <svg class="w-5 h-5" fill="none" stroke="currentColor"
                                                                viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                                    stroke-width="2"
                                                                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                                    stroke-width="2"
                                                                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                                            </svg>
                                                        </a>
                                                        <% if (typeof user !=='undefined' && user &&
                                                            (user.role==='admin' || user.role==='editor' )) { %>
                                                            <a href="/products/<%= product.id || product._id %>/edit"
                                                                class="text-green-600 hover:text-green-800 p-2">
                                                                <svg class="w-5 h-5" fill="none" stroke="currentColor"
                                                                    viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                                        stroke-width="2"
                                                                        d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                                </svg>
                                                            </a>
                                                            <% } %>
                                                                <% if (typeof user !=='undefined' && user &&
                                                                    user.role==='admin' ) { %>
                                                                    <form
                                                                        action="/products/<%= product.id || product._id %>/delete"
                                                                        method="POST"
                                                                        onsubmit="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này?');">
                                                                        <button type="submit"
                                                                            class="text-red-600 hover:text-red-800 p-2">
                                                                            <svg class="w-5 h-5" fill="none"
                                                                                stroke="currentColor"
                                                                                viewBox="0 0 24 24">
                                                                                <path stroke-linecap="round"
                                                                                    stroke-linejoin="round"
                                                                                    stroke-width="2"
                                                                                    d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                                            </svg>
                                                                        </button>
                                                                    </form>
                                                                    <% } %>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <% }); %>
                                </div>
                                <% } else { %>
                                    <!-- Empty State -->
                                    <div class="bg-white/95 backdrop-blur-md rounded-2xl shadow-lg p-12 text-center">
                                        <svg class="w-24 h-24 text-gray-300 mx-auto mb-6" fill="none"
                                            stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                                        </svg>
                                        <h3 class="text-xl font-bold text-gray-800 mb-2">Chưa có sản phẩm nào</h3>
                                        <p class="text-gray-500 mb-6">Bắt đầu bằng cách thêm sản phẩm đầu tiên của bạn.
                                        </p>
                                        <% if (typeof user !=='undefined' && user && (user.role==='admin' ||
                                            user.role==='editor' )) { %>
                                            <a href="/products/create"
                                                class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-3 px-6 rounded-xl transition">
                                                Thêm sản phẩm
                                            </a>
                                            <% } %>
                                    </div>
                                    <% } %>
        </div>

        <%- include('../partials/footer') %>
</body>

</html>