<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thêm sản phẩm | MEU CMS</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500">
    <%- include('../partials/navbar') %>

        <div class="container mx-auto px-4 py-8">
            <div class="max-w-2xl mx-auto">
                <!-- Card -->
                <div class="bg-white/95 backdrop-blur-md rounded-2xl shadow-2xl p-8">
                    <!-- Header -->
                    <div class="flex items-center gap-4 mb-8">
                        <a href="/products" class="text-gray-500 hover:text-gray-700">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                            </svg>
                        </a>
                        <h1 class="text-2xl font-bold text-gray-800">Thêm sản phẩm mới</h1>
                    </div>

                    <!-- Alerts -->
                    <% if (typeof error !=='undefined' && error) { %>
                        <div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded-r-lg">
                            <p class="text-sm">
                                <%= error %>
                            </p>
                        </div>
                        <% } %>

                            <!-- Form -->
                            <form action="/products" method="POST" class="space-y-6">
                                <div>
                                    <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
                                        Tên sản phẩm <span class="text-red-500">*</span>
                                    </label>
                                    <input type="text" name="name" id="name" required
                                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition"
                                        placeholder="Nhập tên sản phẩm">
                                </div>

                                <div>
                                    <label for="slug" class="block text-sm font-medium text-gray-700 mb-2">
                                        Slug <span class="text-red-500">*</span>
                                    </label>
                                    <input type="text" name="slug" id="slug" required pattern="[a-z0-9-]+"
                                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition"
                                        placeholder="ten-san-pham">
                                    <p class="text-xs text-gray-500 mt-1">Chỉ chữ thường, số và dấu gạch ngang</p>
                                </div>

                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <label for="price" class="block text-sm font-medium text-gray-700 mb-2">
                                            Giá <span class="text-red-500">*</span>
                                        </label>
                                        <input type="number" name="price" id="price" required min="0"
                                            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition"
                                            placeholder="0">
                                    </div>
                                    <div>
                                        <label for="quantity" class="block text-sm font-medium text-gray-700 mb-2">
                                            Số lượng <span class="text-red-500">*</span>
                                        </label>
                                        <input type="number" name="quantity" id="quantity" required min="0"
                                            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition"
                                            placeholder="0">
                                    </div>
                                </div>

                                <div>
                                    <label for="description" class="block text-sm font-medium text-gray-700 mb-2">
                                        Mô tả
                                    </label>
                                    <textarea name="description" id="description" rows="4"
                                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition resize-none"
                                        placeholder="Nhập mô tả sản phẩm"></textarea>
                                </div>

                                <div class="flex gap-4 pt-4">
                                    <button type="submit"
                                        class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-3 px-4 rounded-xl transition">
                                        Tạo sản phẩm
                                    </button>
                                    <a href="/products"
                                        class="flex-1 text-center bg-gray-200 hover:bg-gray-300 text-gray-700 font-medium py-3 px-4 rounded-xl transition">
                                        Hủy
                                    </a>
                                </div>
                            </form>
                </div>
            </div>
        </div>

        <%- include('../partials/footer') %>
</body>

</html>