<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chi tiết sản phẩm | MEU CMS</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500">
    <%- include('../partials/navbar') %>

        <div class="container mx-auto px-4 py-8">
            <div class="max-w-3xl mx-auto">
                <!-- Card -->
                <div class="bg-white/95 backdrop-blur-md rounded-2xl shadow-2xl overflow-hidden">
                    <!-- Header with back button -->
                    <div class="bg-gradient-to-r from-indigo-600 to-purple-600 p-6">
                        <div class="flex items-center gap-4">
                            <a href="/products" class="text-white/80 hover:text-white">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                                </svg>
                            </a>
                            <h1 class="text-2xl font-bold text-white">
                                <%= product.name %>
                            </h1>
                        </div>
                    </div>

                    <!-- Image Placeholder -->
                    <div class="h-64 bg-gradient-to-br from-indigo-100 to-purple-100 flex items-center justify-center">
                        <svg class="w-24 h-24 text-indigo-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                    </div>

                    <!-- Content -->
                    <div class="p-8">
                        <div class="space-y-4">
                            <div class="flex items-center justify-between py-3 border-b border-gray-100">
                                <span class="text-gray-600">ID</span>
                                <span class="font-medium text-gray-800">#<%= product.id || product._id %></span>
                            </div>
                            <div class="flex items-center justify-between py-3 border-b border-gray-100">
                                <span class="text-gray-600">Slug</span>
                                <span class="font-mono text-sm bg-gray-100 px-3 py-1 rounded">
                                    <%= product.slug %>
                                </span>
                            </div>
                            <div class="flex items-center justify-between py-3 border-b border-gray-100">
                                <span class="text-gray-600">Giá</span>
                                <span class="font-bold text-indigo-600 text-xl">
                                    <%= product.price ? product.price.toLocaleString('vi-VN') : '0' %> đ
                                </span>
                            </div>
                            <div class="flex items-center justify-between py-3 border-b border-gray-100">
                                <span class="text-gray-600">Số lượng</span>
                                <span class="font-medium text-gray-800">
                                    <%= product.quantity || 0 %>
                                </span>
                            </div>
                            <% if (product.description) { %>
                                <div class="py-3">
                                    <span class="text-gray-600 block mb-2">Mô tả</span>
                                    <p class="text-gray-800">
                                        <%= product.description %>
                                    </p>
                                </div>
                                <% } %>
                        </div>
                    </div>

                    <!-- Actions -->
                    <% if (typeof user !=='undefined' && user && (user.role==='admin' || user.role==='editor' )) { %>
                        <div class="bg-gray-50 px-8 py-6 flex gap-3">
                            <a href="/products/<%= product.id || product._id %>/edit"
                                class="flex-1 text-center bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-3 px-4 rounded-xl transition">
                                Chỉnh sửa
                            </a>
                            <% if (user.role==='admin' ) { %>
                                <form action="/products/<%= product.id || product._id %>/delete" method="POST"
                                    class="flex-1"
                                    onsubmit="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này?');">
                                    <button type="submit"
                                        class="w-full bg-red-500 hover:bg-red-600 text-white font-medium py-3 px-4 rounded-xl transition">
                                        Xóa
                                    </button>
                                </form>
                                <% } %>
                        </div>
                        <% } %>
                </div>
            </div>
        </div>

        <%- include('../partials/footer') %>
</body>

</html>