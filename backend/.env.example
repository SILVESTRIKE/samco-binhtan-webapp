# MongoDB Connection
DATABASE_URL=mongodb://localhost:27017/meu-cms

# Backend URL for internal API calls
BACKEND_URL=http://localhost:3000

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3001

# Enable cleanup job (true/false)
ENABLE_CLEANUP_JOB=false

# JWT Secrets (generate strong random strings for production)
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-change-in-production

# Email Configuration (Gmail SMTP)
# For Gmail, create an App Password: https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
